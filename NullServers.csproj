<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>disable</Nullable>
		<RootNamespace>NullServers</RootNamespace>
		<AssemblyName>NullServers</AssemblyName>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<DefaultItemExcludes>$(DefaultItemExcludes);research/**;dist/**;CustomWeaponsFramework-ST3/**;tests/**</DefaultItemExcludes>
	</PropertyGroup>

	<!-- Game assemblies generated by MelonLoader plus the loader itself. They are provided by the game
	     at runtime, so nothing is copied into the build output. GamePath comes from Directory.Build.props. -->
	<ItemGroup>
		<Reference Include="$(GamePath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
		<Reference Include="$(GamePath)\MelonLoader\net6\MelonLoader.dll;$(GamePath)\MelonLoader\net6\0Harmony.dll;$(GamePath)\MelonLoader\net6\Il2CppInterop.Runtime.dll;$(GamePath)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Directory.Build.props" />
	</ItemGroup>

	<Target Name="InstallMod" AfterTargets="PostBuildEvent" Condition="'$(SkipModInstall)' != 'true'">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods" />
	</Target>
</Project>
